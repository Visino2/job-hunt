# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM backend to use: "anthropic" (default) or "gemini".
# Leave unset / set to "anthropic" once you have Claude API credit again —
# everything else in the app is provider-agnostic.
LLM_PROVIDER=anthropic

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API key (free tier, no card) — https://aistudio.google.com/apikey
# Only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Port the backend listens on
PORT=4000

# Optional shared-password gate for the whole API. Leave unset for local
# dev (no prompt, works exactly as before). Set this when deploying
# somewhere with a public URL, since there's no per-user auth otherwise —
# anyone with the link could read your saved applications and spend your
# LLM API credit. One shared secret, not real user accounts.
APP_PASSWORD=

# Restricts CORS to your deployed frontend's origin (e.g.
# https://job-hunt.netlify.app). Leave unset for local dev (allows all).
CORS_ORIGIN=

# --- Phase 3 (not used yet) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_EMAIL_TO=
